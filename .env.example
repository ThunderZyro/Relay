NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Required: use a PostgreSQL database (Neon works well).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional: comma-separated additional trusted browser origins.
ALLOWED_ORIGINS=
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=10
MAX_USER_STORAGE_MB=500
STAGED_UPLOAD_TTL_HOURS=24
# Optional: S3-compatible persistent upload storage. Leave unset for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
RELAY_UPLOAD_BUCKET=relay-uploads
# Optional: Resend password recovery.
RESEND_API_KEY=
RELAY_EMAIL_FROM=
# Optional: WebRTC TURN server list as a JSON array string. STUN is used without this.
RELAY_ICE_SERVERS=
# Optional: direct PostgreSQL URL for Socket.IO LISTEN/NOTIFY. Neon pooled URLs are converted automatically.
RELAY_REALTIME_DATABASE_URL=
