NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
DATABASE_FILE=./data/relay.sqlite
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=10
MAX_USER_STORAGE_MB=500
STAGED_UPLOAD_TTL_HOURS=24
# Optional comma-separated additional trusted browser origins.
ALLOWED_ORIGINS=
# For a separately hosted frontend, set VITE_API_URL in the frontend build environment.
