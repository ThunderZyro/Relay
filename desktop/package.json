{
  "name": "relay-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Relay desktop client for Windows, macOS and Linux",
  "homepage": "https://relay-platform-gold.vercel.app",
  "desktopName": "com.relay.chat.desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:web": "npm --prefix ../client run build",
    "dist:win": "electron-builder --publish never --win nsis portable --x64",
    "dist:mac": "electron-builder --publish never --mac dmg zip --universal",
    "dist:linux": "electron-builder --publish never --linux AppImage deb --x64"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.relay.chat",
    "productName": "Relay",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;InstantMessaging",
      "maintainer": "Relay Project Maintainers",
      "syncDesktopName": true
    }
  }
}
