{
  "name": "relay-platform",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build --workspace=@relay/client",
    "build:server": "npm run build --workspace=@relay/server",
    "start": "node server/dist/index.js",
    "db:seed": "npm run seed --workspace=@relay/server",
    "test": "npm run test --workspace=@relay/server"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
