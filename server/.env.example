# Required PostgreSQL connection. Neon pooled URL is suitable for normal API queries.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=https://your-relay-domain.example
ALLOWED_ORIGINS=

# Persistent S3-compatible uploads (Neon Object Storage in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
RELAY_UPLOAD_BUCKET=relay-uploads

# Password recovery (Resend)
RESEND_API_KEY=
RELAY_EMAIL_FROM=

# WebRTC TURN provider; JSON array string
RELAY_ICE_SERVERS=
